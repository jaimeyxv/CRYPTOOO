# Entorno: development o production
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_DIR=data

# Binance Spot
BINANCE_API_KEY=
BINANCE_API_SECRET=
USE_TESTNET=true
# Bloqueo irreversible para este APK beta: impide iniciar contra Mainnet
BETA_ONLY=true
# Segunda confirmacion obligatoria para enviar ordenes a Mainnet
ENABLE_LIVE_TRADING=false
SYMBOL=BTCUSDT
HTTP_TIMEOUT_SEG=10

# Panel y sesion
PANEL_PASSWORD=cambia_esto
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=reemplaza_con_un_valor_aleatorio_de_al_menos_32_caracteres
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1
# Dominio usado por compose.production.yaml y Caddy
DOMAIN=

# Notificaciones Android (JSON completo o JSON codificado en Base64)
FCM_SERVICE_ACCOUNT_JSON=

# Estrategia
INTERVAL=1h
SMA_RAPIDA=9
SMA_LENTA=21
RSI_PERIODO=14
RSI_SOBRECOMPRA=70
RSI_SOBREVENTA=30
ANALISIS_SEG=30

# Ejecucion y protecciones
ORDEN_USDT=100
COMPRAR_CAIDA_PCT=1.0
TAKE_PROFIT_PCT=2.0
STOP_LOSS_PCT=1.0
CAIDA_VENTANA=24
MAX_OPERACIONES_DIA=10
PERDIDA_MAX_DIARIA_USDT=50
COOLDOWN_SEG=300
